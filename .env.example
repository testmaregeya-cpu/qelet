# Supabase project URL and public anon/publishable key (from Supabase Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Cloud OAuth Web Client ID (for @react-native-google-signin/google-signin -> Supabase signInWithIdToken)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
